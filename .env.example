# Root directory used to resolve relative paths.
HASHGUARD_ROOT=.

# Required. Generate distinct random values; never use the example placeholders.
SECRET_KEY=replace_with_a_long_random_secret
BASELINE_HMAC_KEY=replace_with_a_long_random_secret

# Enable Flask debug mode only for local development; defaults to false.
FLASK_DEBUG=false

# Session cookies default to Secure outside debug mode.
SESSION_COOKIE_SECURE=true

# Registration is first-user-only by default; true permits subsequent accounts.
ALLOW_REGISTRATION=false

# SQLite database path; relative paths resolve from HASHGUARD_ROOT.
DATABASE_PATH=database/security.db
LOGS_DIR=logs
REPORTS_DIR=reports

# The watched folder must exist under SCAN_ROOT. UI changes must remain under it.
SCAN_ROOT=watched
WATCHED_FOLDER=.
BASELINE_FILE=baseline/hashes.json
WHITELIST_FILE=config/whitelist.json

# Shared Flask-Limiter storage URI. Use Redis for multi-worker deployments.
RATELIMIT_STORAGE_URI=memory://

# Initial scheduler interval in seconds; UI settings override it persistently.
SCAN_INTERVAL_SECONDS=300

# Optional metadata-only scan shortcut; can miss changes that preserve metadata.
SCAN_METADATA_CACHE=false

# Cooldown before the same unchanged, unresolved alert can notify again.
ALERT_COOLDOWN_SECONDS=3600

# Optional UDP syslog forwarding; leave SYSLOG_HOST blank to disable.
SYSLOG_HOST=
SYSLOG_PORT=514
SYSLOG_FACILITY=user

# Optional SMTP sender credentials. Gmail requires an App Password.
EMAIL_ADDRESS=
EMAIL_PASSWORD=

# SMTP server using STARTTLS. Defaults to smtp.gmail.com:587.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Optional fallback recipient; Settings in the app takes precedence.
TO_EMAIL=
